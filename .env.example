# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose maps container 5432 -> host 5433) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/brightsmile

# --- LLM providers (model IDs live in configs/models.yaml) ---
GROQ_API_KEY=
# Optional second Groq key used only by the generator (separate rate-limit bucket).
# Leave empty to use GROQ_API_KEY for everything.
GROQ_GENERATOR_API_KEY=
# Used for both the Gemini judge and Gemini embeddings (free tier)
GEMINI_API_KEY=

# --- API ---
ADMIN_API_KEY=change-me
LOG_LEVEL=INFO

# --- Eval ---
# Directory for the prompt-hash LLM call cache (keeps eval runs cheap & deterministic)
LLM_CACHE_DIR=.cache/llm
